    seasonCI=new Chart(ctx,{data:{labels:['January','February','March','April'],datasets:[
      {type:'bar',label:'Purchases 2025',data:p25,backgroundColor:'rgba(58,110,168,0.5)',yAxisID:'y'},
      {type:'bar',label:'Purchases 2026',data:p26,backgroundColor:'rgba(242,101,34,0.5)',yAxisID:'y'},
      {type:'line',label:'ROAS 2025',data:r25,borderColor:C.blue,pointRadius:5,yAxisID:'y2',tension:.2,borderWidth:2,borderDash:[4,4]},
      {type:'line',label:'ROAS 2026',data:r26,borderColor:C.brand,pointRadius:5,yAxisID:'y2',tension:.2,borderWidth:2},
    ]},options:{responsive:true,maintainAspectRatio:false,
      scales:{y:{position:'left',ticks:{font:{size:10}},grid:yGrid},
        y2:{position:'right',grid:{display:false},ticks:{callback:v=>v+'x',font:{size:10}},min:0,max:12},
        x:{ticks:{font:{size:10}},grid:{display:false}}},
      plugins:{legend:{position:'bottom',labels:{font:{size:10},padding:8,boxWidth:10}}}}});
  }
}

