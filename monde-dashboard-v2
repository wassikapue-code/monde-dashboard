let seasonCI = null;
function switchSeason(type, btn) {
  document.querySelectorAll('#sec-seasonal .inner-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  if(seasonCI){seasonCI.destroy();seasonCI=null;}
  const ctx=document.getElementById('seasonChart').getContext('2d');
  const ins=document.getElementById('season-ins');
  const xScale={ticks:{autoSkip:false,maxRotation:45,font:{size:9}},grid:{display:false}};
  const yGrid={color:'rgba(0,0,0,0.05)'};

  if(type==='mom'){
    // MoM % change purchases
    const momP=purch.map((v,i)=>i===0?null:Math.round((v-purch[i-1])/purch[i-1]*100));
    const momS=spend.map((v,i)=>i===0?null:Math.round((v-spend[i-1])/spend[i-1]*100));
    ins.innerHTML=`<strong>MoM Insight:</strong> Feb25 spike +221% (OCC promo burst). May/Jun เป็น Natural Low Season (-18% avg). Jul กลับมา +70%. Dec peak +39%. Feb→Mar 2026 ROAS ยังลดต่อเนื่องสวนทาง spend ที่เพิ่ม`;
    seasonCI=new Chart(ctx,{type:'bar',data:{labels:M.slice(1),datasets:[
      {label:'Purchase MoM%',data:momP.slice(1),backgroundColor:momP.slice(1).map(v=>v>=0?'rgba(45,138,94,0.6)':'rgba(192,64,64,0.6)'),yAxisID:'y'},
      {label:'Spend MoM%',data:momS.slice(1),borderColor:C.blue,type:'line',pointRadius:3,yAxisID:'y',tension:.3,borderWidth:1.5,fill:false}
    ]},options:{responsive:true,maintainAspectRatio:false,
      scales:{y:{ticks:{callback:v=>v+'%',font:{size:10}},grid:yGrid},x:xScale},
      plugins:{legend:{display:false}}}});

  } else if(type==='half'){
    // H1 vs H2 by month position (bar side-by-side)
    const h1months=['Jan','Feb','Mar','Apr','May','Jun'];
    const h1p25=[174,559,314,282,275,271];
    const h2p25=[460,453,413,419,447,622];
    const h1r25=[3.19,9.46,6.25,4.43,3.48,3.73];
    const h2r25=[5.60,4.36,3.63,4.16,3.46,4.91];
    ins.innerHTML=`<strong>H1 vs H2 Pattern 2025:</strong> H2 มี Purchase สูงกว่าทุกเดือน (Jul > Jan เสมอ) แต่ ROAS H2 ต่ำกว่า H1 ยกเว้น Jul–Aug เพราะ KOL scale-up ใน Sep–Dec drag ROAS ลง. Dec เป็น outlier ที่ดี`;
    seasonCI=new Chart(ctx,{data:{labels:h1months,datasets:[
      {type:'bar',label:'H1 2025 Purchases',data:h1p25,backgroundColor:'rgba(58,110,168,0.5)',yAxisID:'y'},
      {type:'bar',label:'H2 2025 Purchases',data:h2p25,backgroundColor:'rgba(242,101,34,0.5)',yAxisID:'y'},
      {type:'line',label:'H1 ROAS',data:h1r25,borderColor:C.blue,pointRadius:4,yAxisID:'y2',tension:.2,borderWidth:2,borderDash:[4,4]},
      {type:'line',label:'H2 ROAS',data:h2r25,borderColor:C.brand,pointRadius:4,yAxisID:'y2',tension:.2,borderWidth:2},
    ]},options:{responsive:true,maintainAspectRatio:false,
      scales:{y:{position:'left',ticks:{font:{size:10}},grid:yGrid},
        y2:{position:'right',grid:{display:false},ticks:{callback:v=>v+'x',font:{size:10}},min:0,max:12},
        x:{ticks:{font:{size:10}},grid:{display:false}}},
      plugins:{legend:{position:'bottom',labels:{font:{size:10},padding:8,boxWidth:10}}}}});

  } else {
    // YoY Jan-Apr
    const labels25=['Jan 2025','Feb 2025','Mar 2025','Apr 2025'];
    const labels26=['Jan 2026','Feb 2026','Mar 2026','Apr 2026'];
    const p25=[174,559,314,282]; const p26=[642,398,387,283];
    const r25=[3.19,9.46,6.25,4.43]; const r26=[6.45,3.31,2.77,2.08];
