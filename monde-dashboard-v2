<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monde Eyewear — Facebook Ads Dashboard v2</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --brand:#F26522;--brand-light:#FDE8D8;--brand-dark:#C44D10;
    --ink:#1A1412;--ink-2:#4A3F3A;--ink-3:#8A7A74;
    --surface:#FDFAF8;--surface-2:#F5EDE7;--surface-3:#EDE0D8;
    --border:#E2D5CC;
    --green:#2D8A5E;--green-light:#D4EDE3;
    --red:#C04040;--red-light:#F5DADA;
    --blue:#3A6EA8;--blue-light:#D6E5F5;
    --amber:#C07820;--amber-light:#F5E6C8;
    --purple:#6B4E9B;--purple-light:#EAE3F5;
    --teal:#1E7E78;--teal-light:#D2EDEC;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:'DM Sans',sans-serif;background:var(--surface);color:var(--ink);font-size:13px;line-height:1.5;}

  .header{background:var(--ink);padding:20px 28px 18px;display:flex;align-items:center;gap:16px;border-bottom:3px solid var(--brand);}
  .header-logo{width:36px;height:36px;background:var(--brand);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:15px;color:#fff;flex-shrink:0;}
  .header-title{font-family:'Syne',sans-serif;font-weight:700;font-size:16px;color:#fff;}
  .header-sub{font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;}
  .header-right{margin-left:auto;display:flex;gap:6px;align-items:center;}
  .period-badge{display:inline-block;background:var(--brand);color:#fff;font-size:10px;font-weight:600;padding:3px 10px;border-radius:20px;letter-spacing:0.04em;text-transform:uppercase;}
  .v2-badge{background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.7);font-size:10px;padding:3px 8px;border-radius:20px;}

  .nav{background:#fff;border-bottom:1px solid var(--border);padding:0 28px;display:flex;gap:0;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,0.06);overflow-x:auto;}
  .nav-tab{padding:12px 16px;font-size:12px;font-weight:500;color:var(--ink-3);cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap;}
  .nav-tab:hover{color:var(--brand);}
  .nav-tab.active{color:var(--brand);border-bottom-color:var(--brand);font-weight:600;}

  .main{padding:24px 28px;max-width:1200px;}
  .section{display:none;}
  .section.active{display:block;}

  .kpi-strip{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:20px;}
  .kpi{background:#fff;border:1px solid var(--border);border-radius:10px;padding:14px 16px;position:relative;overflow:hidden;}
  .kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--brand);}
  .kpi.green::after{background:var(--green);}
  .kpi.blue::after{background:var(--blue);}
  .kpi.amber::after{background:var(--amber);}
  .kpi.red::after{background:var(--red);}
  .kpi.purple::after{background:var(--purple);}
  .kpi.teal::after{background:var(--teal);}
  .kpi-label{font-size:10px;color:var(--ink-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;}
  .kpi-val{font-family:'Syne',sans-serif;font-size:22px;font-weight:700;color:var(--ink);line-height:1;}
  .kpi-sub{font-size:10px;color:var(--ink-3);margin-top:4px;}

  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
  .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px;}
  .grid-65-35{display:grid;grid-template-columns:65fr 35fr;gap:14px;margin-bottom:14px;}
  .grid-60-40{display:grid;grid-template-columns:60fr 40fr;gap:14px;margin-bottom:14px;}
  .grid-55-45{display:grid;grid-template-columns:55fr 45fr;gap:14px;margin-bottom:14px;}

  .card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:16px 18px;}
  .card-title{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ink-2);margin-bottom:12px;display:flex;align-items:center;gap:8px;}
  .card-title .dot{width:8px;height:8px;border-radius:2px;background:var(--brand);flex-shrink:0;}
  .card-title .dot.green{background:var(--green);}
  .card-title .dot.blue{background:var(--blue);}
  .card-title .dot.red{background:var(--red);}
  .card-title .dot.amber{background:var(--amber);}
  .card-title .dot.purple{background:var(--purple);}
  .card-title .dot.teal{background:var(--teal);}

  .chart-wrap{position:relative;}
  .chart-h180{height:180px;}
  .chart-h200{height:200px;}
  .chart-h220{height:220px;}
  .chart-h240{height:240px;}
  .chart-h260{height:260px;}
  .chart-h280{height:280px;}
  .chart-h300{height:300px;}

  .inner-tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;}
  .inner-tab{font-size:11px;font-weight:500;padding:4px 12px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--ink-3);cursor:pointer;transition:all .12s;}
  .inner-tab:hover{border-color:var(--brand);color:var(--brand);}
  .inner-tab.active{background:var(--brand);color:#fff;border-color:var(--brand);}

  .legend{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:10px;}
  .leg-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--ink-3);}
  .leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
  .leg-circle{border-radius:50%;}
  .leg-dash{height:2px;width:14px;flex-shrink:0;}

  .bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
  .bar-label{width:90px;font-size:11px;color:var(--ink-2);flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bar-label-w120{width:120px;}
  .bar-bg{flex:1;height:7px;background:var(--surface-2);border-radius:4px;overflow:hidden;}
  .bar-fill{height:100%;border-radius:4px;transition:width .4s ease;}
  .bar-val{font-size:11px;color:var(--ink-2);width:65px;text-align:right;flex-shrink:0;font-weight:500;}

  .badge{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:10px;}
  .badge-green{background:var(--green-light);color:var(--green);}
  .badge-red{background:var(--red-light);color:var(--red);}
  .badge-amber{background:var(--amber-light);color:var(--amber);}
  .badge-blue{background:var(--blue-light);color:var(--blue);}
  .badge-brand{background:var(--brand-light);color:var(--brand-dark);}
  .badge-neutral{background:var(--surface-2);color:var(--ink-3);}
  .badge-purple{background:var(--purple-light);color:var(--purple);}
  .badge-teal{background:var(--teal-light);color:var(--teal);}

  .insight-box{background:var(--surface-2);border-left:3px solid var(--brand);border-radius:0 8px 8px 0;padding:10px 14px;margin-top:12px;font-size:12px;color:var(--ink-2);line-height:1.6;}
  .insight-box.green{border-left-color:var(--green);}
  .insight-box.red{border-left-color:var(--red);}
  .insight-box.amber{border-left-color:var(--amber);}
  .insight-box.blue{border-left-color:var(--blue);}
  .insight-box.purple{border-left-color:var(--purple);}
  .insight-box strong{color:var(--ink);}

  .mini-table{width:100%;border-collapse:collapse;font-size:11px;}
  .mini-table th{text-align:left;padding:6px 8px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--ink-3);border-bottom:1px solid var(--border);}
  .mini-table td{padding:7px 8px;border-bottom:1px solid var(--surface-2);color:var(--ink-2);}
  .mini-table tr:last-child td{border-bottom:none;}
  .mini-table tr:hover td{background:var(--surface-2);}
  .td-right{text-align:right;font-weight:500;}
  .td-good{color:var(--green);font-weight:600;}
  .td-bad{color:var(--red);font-weight:600;}
  .td-ok{color:var(--amber);font-weight:600;}
  .td-na{color:var(--ink-3);}

  .section-head{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--ink-2);margin-bottom:14px;text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:8px;}
  .section-head::after{content:'';flex:1;height:1px;background:var(--border);}

  .verdict-row{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--surface-2);border-radius:8px;margin-bottom:6px;font-size:12px;}
  .verdict-row .v-type{font-weight:600;color:var(--ink);width:70px;flex-shrink:0;}
  .verdict-row .v-spend{color:var(--ink-3);width:80px;flex-shrink:0;font-size:11px;}
  .verdict-row .v-roas{font-family:'Syne',sans-serif;font-weight:700;width:50px;}

  .action-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px;}
  .action-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:14px 16px;position:relative;overflow:hidden;}
  .action-num{font-family:'Syne',sans-serif;font-size:36px;font-weight:800;color:var(--surface-3);position:absolute;right:10px;top:4px;line-height:1;}
  .action-tag{margin-bottom:8px;}
  .action-title{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:6px;}
  .action-body{font-size:11px;color:var(--ink-3);line-height:1.6;}

  .bm-item{background:var(--surface-2);border-radius:8px;padding:10px 12px;border:1px solid var(--border);}
  .bm-label{font-size:10px;color:var(--ink-3);margin-bottom:4px;}
  .bm-val{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--ink);}
  .bm-note{font-size:10px;color:var(--ink-3);margin-top:2px;}
  .benchmark-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px;}

  .notice-box{background:var(--blue-light);border:1px solid #A8C4E2;border-radius:8px;padding:10px 14px;font-size:11px;color:var(--blue);margin-bottom:12px;line-height:1.6;}
  .notice-box strong{color:var(--blue);}

  .divider{height:1px;background:var(--border);margin:16px 0;}

  /* Seasonal */
  .season-pill{display:inline-block;font-size:10px;font-weight:600;padding:3px 10px;border-radius:12px;margin-right:4px;}
  .sp-high{background:#D4EDE3;color:#1A5C3A;}
  .sp-low{background:#F5DADA;color:#6B1A1A;}
  .sp-mid{background:#F5E6C8;color:#7A4A00;}

  @media(max-width:900px){
    .kpi-strip{grid-template-columns:repeat(3,1fr);}
    .grid-2,.grid-3,.grid-65-35,.grid-60-40,.grid-55-45{grid-template-columns:1fr;}
    .benchmark-grid{grid-template-columns:repeat(2,1fr);}
    .action-cards{grid-template-columns:1fr;}
    .main{padding:16px;}
  }
</style>
</head>
<body>

<div class="header">
  <div class="header-logo">M</div>
  <div>
    <div class="header-title">Monde Eyewear — Facebook Ads Performance</div>
    <div class="header-sub">Jan 2025 – Apr 2026 · 16 months · Ad-level analysis</div>
  </div>
  <div class="header-right">
    <span class="v2-badge">v2</span>
    <span class="period-badge">Jan 25 – Apr 26</span>
  </div>
</div>

<div class="nav">
  <div class="nav-tab active" onclick="showSection('overview')">📊 Overview</div>
  <div class="nav-tab" onclick="showSection('structure')">🏗 Structure</div>
  <div class="nav-tab" onclick="showSection('working')">✅ What's Working</div>
  <div class="nav-tab" onclick="showSection('notworking')">⚠️ What's Not Working</div>
  <div class="nav-tab" onclick="showSection('seasonal')">📅 Seasonal</div>
  <div class="nav-tab" onclick="showSection('benchmark')">🎯 Benchmarks</div>
  <div class="nav-tab" onclick="showSection('action')">🚀 Next Actions</div>
</div>

<div class="main">

<!-- ===== OVERVIEW ===== -->
<div class="section active" id="sec-overview">

  <div class="kpi-strip">
    <div class="kpi">
      <div class="kpi-label">Total Spend</div>
      <div class="kpi-val">฿8.35M</div>
      <div class="kpi-sub">16 months Jan25–Apr26</div>
    </div>
    <div class="kpi blue">
      <div class="kpi-label">Avg Monthly Spend</div>
      <div class="kpi-val">฿522K</div>
      <div class="kpi-sub">Range ฿263K–฿744K</div>
    </div>
    <div class="kpi green">
      <div class="kpi-label">Total Purchases</div>
      <div class="kpi-val">6,399</div>
      <div class="kpi-sub">Offline attributed</div>
    </div>
    <div class="kpi green">
      <div class="kpi-label">Overall ROAS</div>
      <div class="kpi-val">4.24x</div>
      <div class="kpi-sub">Revenue ฿35.4M</div>
    </div>
    <div class="kpi teal">
      <div class="kpi-label">Total Reach</div>
      <div class="kpi-val">145M</div>
      <div class="kpi-sub">Unique accounts reached</div>
    </div>
    <div class="kpi red">
      <div class="kpi-label">Trend ROAS Apr26</div>
      <div class="kpi-val">↘ 2.08x</div>
      <div class="kpi-sub">ต่ำสุด 16 เดือน</div>
    </div>
  </div>

  <div class="card" style="margin-bottom:14px;">
    <div class="card-title"><span class="dot"></span>Monthly Spend · Purchases · ROAS · Reach</div>
    <div class="inner-tabs">
      <button class="inner-tab active" onclick="switchMain('spend',this)">Spend & Purchases</button>
      <button class="inner-tab" onclick="switchMain('roas',this)">ROAS Trend</button>
      <button class="inner-tab" onclick="switchMain('reach',this)">Reach Trend</button>
      <button class="inner-tab" onclick="switchMain('cpm',this)">CPM Trend</button>
      <button class="inner-tab" onclick="switchMain('stack',this)">Budget by Type</button>
    </div>
    <div class="legend" id="main-leg">
      <span class="leg-item"><span class="leg-dot" style="background:#B5D4F4"></span>Spend (฿)</span>
      <span class="leg-item"><span class="leg-dot leg-circle" style="background:var(--green)"></span>Purchases (qty)</span>
    </div>
    <div class="chart-wrap chart-h260"><canvas id="mainChart"></canvas></div>
    <div class="insight-box" id="main-ins">
      <strong>Peak Performance:</strong> Jan–Feb 2025 ROAS สูงสุด (9.46x) ช่วง Launch phase + Low competition.
      H2/2025 KOL Budget ขยาย 10x แต่ ROAS ดิ่ง. Apr 2026 ROAS เหลือ 2.08x — ต่ำสุด 16 เดือน.
    </div>
  </div>

  <div class="grid-65-35">
    <div class="card">
      <div class="card-title"><span class="dot blue"></span>Budget Allocation by Objective</div>
      <div class="chart-wrap chart-h200"><canvas id="objChart"></canvas></div>
    </div>
    <div class="card">
      <div class="card-title"><span class="dot green"></span>ROAS & Reach by Objective</div>
      <table class="mini-table">
        <thead><tr><th>Objective</th><th>Spend%</th><th class="td-right">ROAS</th><th class="td-right">Verdict</th></tr></thead>
        <tbody>
          <tr><td>Engagement</td><td>88%</td><td class="td-right td-good">4.65x</td><td class="td-right"><span class="badge badge-green">Core</span></td></tr>
          <tr><td>Traffic</td><td>2%</td><td class="td-right td-ok">4.40x</td><td class="td-right"><span class="badge badge-blue">OK</span></td></tr>
          <tr><td>Awareness</td><td>10%</td><td class="td-right td-bad">0.57x</td><td class="td-right"><span class="badge badge-red">Drain</span></td></tr>
          <tr><td>Sales</td><td>&lt;1%</td><td class="td-right td-bad">0.30x</td><td class="td-right"><span class="badge badge-red">Weak</span></td></tr>
        </tbody>
      </table>
      <div class="insight-box red" style="margin-top:10px;">
        <strong>Awareness 10% Budget → ROAS 0.57x</strong> — ขาดทุนสุทธิ ส่วนมากมาจาก BRD campaign ที่ใช้ Awareness obj โดยตรง ซึ่งเป็น expected behavior สำหรับ Brand campaign
      </div>
    </div>
  </div>
</div>

<!-- ===== STRUCTURE ===== -->
<div class="section" id="sec-structure">

  <div class="kpi-strip">
    <div class="kpi green">
      <div class="kpi-label">AWO ROAS</div>
      <div class="kpi-val">15.2x</div>
      <div class="kpi-sub">Best performer · 12% budget</div>
    </div>
    <div class="kpi amber">
      <div class="kpi-label">KOL Budget Share</div>
      <div class="kpi-val">32%</div>
      <div class="kpi-sub">KOL_SO + KOL_FS + KOL</div>
    </div>
    <div class="kpi blue">
      <div class="kpi-label">SO Budget Share</div>
      <div class="kpi-val">31%</div>
      <div class="kpi-sub">New Store Opening</div>
    </div>
    <div class="kpi purple">
      <div class="kpi-label">BRD Budget Share</div>
      <div class="kpi-val">9%</div>
      <div class="kpi-sub">Brand Awareness — ไม่วัด Purchase</div>
    </div>
    <div class="kpi teal">
      <div class="kpi-label">OCC ROAS</div>
      <div class="kpi-val">8.4x</div>
      <div class="kpi-sub">Promo burst — underrated</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Album vs VDO</div>
      <div class="kpi-val">6.2x vs 1.95x</div>
      <div class="kpi-sub">ROAS — Album wins 3x</div>
    </div>
  </div>

  <div class="section-head">Campaign Type — Full Breakdown</div>

  <!-- Notice for BRD -->
  <div class="notice-box">
    <strong>📌 หมายเหตุ BRD (Brand Campaign):</strong> วัตถุประสงค์หลักคือ Awareness ไม่ใช่ Purchase — Purchase ที่ track ได้ต่ำเป็นเรื่องปกติ
    การประเมิน BRD ควรใช้ Reach, CPM และ Brand recall เป็น KPI หลัก ไม่ใช่ ROAS
  </div>

  <div class="card" style="margin-bottom:14px;">
    <div class="card-title"><span class="dot"></span>Spend vs Purchases by Campaign Type (Monthly Stacked)</div>
    <div class="chart-wrap chart-h260"><canvas id="ctStackChart"></canvas></div>
  </div>

  <div class="card" style="margin-bottom:14px;">
    <div class="card-title"><span class="dot"></span>Campaign Type Summary</div>
    <div style="overflow-x:auto;">
      <table class="mini-table">
        <thead>
          <tr>
            <th>Type</th><th>Sub</th>
            <th class="td-right">Total Spend</th><th class="td-right">Spend%</th>
            <th class="td-right">Purchases</th><th class="td-right">ROAS</th>
            <th class="td-right">CPP avg</th><th class="td-right">KPI</th><th class="td-right">Verdict</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>AWO</strong></td><td class="td-na">Always-On Retargeting</td>
            <td class="td-right">฿977K</td><td class="td-right">12%</td>
            <td class="td-right">2,646</td><td class="td-right td-good">15.2x</td>
            <td class="td-right td-good">฿369</td><td class="td-right">Purchase</td>
            <td class="td-right"><span class="badge badge-green">★ Star</span></td>
          </tr>
          <tr>
            <td><strong>KOL_SO</strong></td><td class="td-na">KOL × New Store</td>
            <td class="td-right">฿2.50M</td><td class="td-right">30%</td>
            <td class="td-right">906</td><td class="td-right td-bad">2.28x</td>
            <td class="td-right td-bad">฿2,763</td><td class="td-right">Purchase</td>
            <td class="td-right"><span class="badge badge-red">Review</span></td>
          </tr>
          <tr>
            <td><strong>SO</strong></td><td class="td-na">New Store (Non-KOL)</td>
            <td class="td-right">฿2.60M</td><td class="td-right">31%</td>
            <td class="td-right">1,204</td><td class="td-right td-ok">2.47x</td>
            <td class="td-right td-ok">฿2,157</td><td class="td-right">Purchase/Reach*</td>
            <td class="td-right"><span class="badge badge-amber">Watch</span></td>
          </tr>
          <tr>
            <td><strong>FS</strong></td><td class="td-na">Focus Store</td>
            <td class="td-right">฿784K</td><td class="td-right">9%</td>
            <td class="td-right">585</td><td class="td-right td-good">3.84x</td>
            <td class="td-right td-good">฿1,340</td><td class="td-right">Purchase</td>
            <td class="td-right"><span class="badge badge-brand">Good</span></td>
          </tr>
          <tr>
            <td><strong>KOL_FS</strong></td><td class="td-na">KOL × Focus Store</td>
            <td class="td-right">฿155K</td><td class="td-right">2%</td>
